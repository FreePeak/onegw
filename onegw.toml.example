# onegw configuration.
# Providers may also take keys from env: ONEGW_PROVIDER_<NAME>_KEY
# Gateway client keys: ONEGW_KEYS="key1,key2"

[server]
listen = "127.0.0.1:8080"      # loopback-only default; "0.0.0.0:8080" exposes to LAN
data_dir = "data"              # usage.db lives here; "memory" disables persistence
max_body_bytes = 33554432      # 32 MiB per-request cap
buffered_budget_bytes = 50331648 # 48 MiB global buffered-path budget
admin_password = ""            # ONEGW_ADMIN_PASSWORD overrides
# Pre-first-byte upstream budget: dial + TLS + full request-body upload +
# upstream prefill. 60s default aborts massive thinking-model prefills
# (100-300K-token sessions) with "http2: timeout awaiting response headers".
# Applied on startup and SIGHUP reload.
# response_header_timeout = "120s"

[saver]
enabled = true                 # RTK-style tool_result compression

# Output-side savers (each also requires the [saver] enabled flag):
# [[saver.inject]]  — prepend an honest terse-output directive to the system prompt
#   mode = "caveman"|"terse"|"ponytail"|"custom" (custom needs text); models = globs, empty = all
# [saver.external]  — send big bodies' messages[] to a Headroom-style /v1/compress service
#   url, timeout_ms (default 2000), min_bytes (default 32768), fail_open (default true)
# [[saver.inject]]
# mode = "terse"
# models = []
# [saver.external]
# enabled = true
# url = "http://127.0.0.1:8819/v1/compress"

[usage]
flush_interval = "5s"
retention_days = 90
# Optional: forward every flushed rollup window to a central onegw (make it
# the aggregator by pointing export_url at its /admin/usage/import).
# Fire-and-forget: one retry, never blocks the flush loop, local store is
# always written first. ONEGW_EXPORT_PASSWORD overrides export_password.
# export_url = "http://agg-host:8080/admin/usage/import"
# export_password = "agg-admin-password"

# Task-aware combo reordering (issue #54): with "on", each request is
# classified locally (prompt size, message/tool count, max_tokens,
# reasoning_effort, a few keyword regexes — no LLM call) and multi-target
# combos are stable-re-sorted so the best-fit model is tried first. The
# full fallback chain is preserved. Off (default) = byte-identical routing.
# Per-model capability scores ride the provider def (see [[providers.tier]]).
# Decision lines appear in /admin logs when the order actually changes.
# ONEGW_TASK_ROUTING=on|off overrides.
# task_routing = "on"

# --- Providers -------------------------------------------------------------

[[providers]]
name = "openrouter"
kind = "openai"
base_url = "https://openrouter.ai/api"
# api_key = "..." or env ONEGW_PROVIDER_OPENROUTER_KEY
models = ["openai/gpt-5.5", "anthropic/claude-sonnet-4.5", "deepseek/deepseek-v3.2"]
# Always-thinking models: upstream reasons unconditionally and rejects
# reasoning_effort medium / thinking:{type:"disabled"} (GLM: 400, use
# low|high|max). Matching requests are rewritten server-side
# (medium->low, disable knobs dropped). Globs: path.Match, "*" does not
# cross "/".
# always_thinking = ["glm-5.3*"]
# Quota window (issue #7): track usage per provider against a reset window
# and optionally enforce limits. quota_window = "5h" | "daily" | "weekly"
# ("" = off). daily resets at UTC midnight, weekly at ISO Monday 00:00 UTC,
# 5h rolls from the window start (first request after a reset). An optional
# quota_reset_anchor (ISO time) pins the grid: its time-of-day phases daily
# resets, its instant phases 5h/weekly grids. quota_limit_tokens caps
# input+output+reasoning tokens per window and quota_limit_requests caps
# request count; 0 = track only (visible on /admin/quota and the dashboard,
# never blocking). When exhausted, the provider cools until windowEnd and
# answers 503 (combos fall through to the next target).
# quota_window = "5h"
# quota_reset_anchor = "2026-01-01T00:00:00Z"
# quota_limit_tokens = 2000000
# quota_limit_requests = 500
#
# Passthrough surfaces: opt this provider into OpenAI-format endpoints served
# verbatim without translation. Values: "embeddings", "stt" (POST
# /v1/audio/transcriptions), "tts" (POST /v1/audio/speech). Bodies relay
# byte-for-byte; only the model selector is rewritten. A provider without
# the marker answers 404 passthrough_not_supported on those surfaces.
# passthrough = ["embeddings", "stt", "tts"]
#
# Session affinity: when the client sends none of the forwarded identity
# headers (x-grok-conv-id, x-grok-session-id, x-session-id, session_id —
# always relayed verbatim), opts this provider into deriving a stable
# per-key opaque id ("ses_" + hex) and sending it in the named header.
# Keeps upstream prompt caches warm (issue #36; e.g. xAI x-grok-conv-id).
# Default "" never invents a header; client-sent values always win.
# session_header = "x-grok-conv-id"
#
# Prompt-cache profile (issue #34): opts this provider into upstream
# cache anchoring, applied last after every body mutation (model rewrite,
# token saver, always-thinking adaptation, cross-format translation).
#   "" / "none"          byte-identical passthrough (default; GLM,
#                        DeepSeek and b-ai ignore cache fields — nothing
#                        is invented)
#   "sticky-key"         inject the session identity as prompt_cache_key
#                        (xAI, OpenRouter, Kimi)
#   "dashscope-marker"   keep client cache_control markers (Qwen, max 4)
#   "claude-anchor"      strip + re-anchor ephemeral markers on the last
#                        system block / cache-eligible tool / last
#                        assistant turn (Anthropic-format upstreams)
# cache_profile = "sticky-key"

[[providers]]
name = "anthropic"
kind = "anthropic"
models = ["claude-sonnet-4-5", "claude-haiku-4-5"]

[[providers]]
name = "gemini"
kind = "gemini"
models = ["gemini-3-pro", "gemini-3-flash"]

[[providers]]
name = "opencode"
kind = "opencode"               # OpenCode Zen Go subscription; base_url defaults
                                # to https://opencode.ai/zen/go
# models = [...]                # optional; omitted = full live Go catalog (35 models).
                                # gpt-*/grok-*/muse-spark-* auto-route to /v1/responses.
# always_thinking = ["glm-5.3*"]
# keys = ["...", "..."]         # one account per key — or use accounts:
[[providers.accounts]]
name = "key-1"
api_key = ""                    # fill or use env
                                # rpm = 6  per-account budget (see below)

[[providers.accounts]]
name = "key-2"
api_key = ""                    # fill or use env

# rpm at the [[providers]] level is a SHARED budget for every account of
# the provider (one token bucket), for upstreams whose rate limit is per
# user / per model lane, not per key — e.g. new-api aggregators ("Maximum
# 8 requests within 1 minutes" hitting ANY key). Size to the upstream
# limit minus 2 (the bucket holds a 2-request burst): rpm = 6 for an
# 8/min wall. Per-account rpm above works alongside it.

# OpenAI Responses-wire upstream (e.g. orcarouter.ai): clients keep using
# /v1/chat/completions; onegw translates to {base_url}/responses.
[[providers]]
name = "orcarouter"
kind = "openai-responses"
base_url = "https://api.orcarouter.ai/v1"
models = ["z-ai/glm-5.3-flash-free", "deepseek/deepseek-v4-flash-free"]
[[providers.accounts]]
name = "me"
api_key = ""                    # fill or use env

# --- Web search (virtual provider) ------------------------------------------

[[providers]]
name = "search"
kind = "searxng"               # SearXNG JSON API at {base_url}/search
base_url = "http://searx:8080" # required
max_results = 5                # results formatted into the completion (0 = 5)
timeout = "10s"                # per-search timeout (0 = 10s)
# models = ["web"]             # optional extra aliases: model "search/web"
# If the instance requires auth (SearXNG accepts X-API-Key or basic auth):
#[providers.extra_headers]
#X-API-Key = "..."

[[combo]]
name = "search-or-llm"         # fail-open: search down -> falls to the model
targets = ["search/query", "b-ai/mimo-v2.5"]

# --- Combos (ordered fallback) ----------------------------------------------

[[combo]]
name = "coding-stack"
targets = ["anthropic/claude-sonnet-4-5", "gemini/gemini-3-pro", "openrouter/deepseek/deepseek-v3.2"]
# strategy = "fastest" reorders the chain per request by each leg's recent
# decode speed (tokens/sec EWMA, shown on the dashboard Overview). Legs
# with no speed data keep the configured order; nothing is ever removed
# from the chain. Default "" keeps the configured sequence verbatim.

# Model tiering (issue #44 step 1, config-only): define a cheap combo and a
# strong combo, then point the agent CLI's role slots at them (smol/tiny ->
# tiny, default/plan -> planning; see README "Model tiering"). The client
# knows the task type; the gateway just routes.
# [[combo]]
# name = "tiny"                   # free/flash-tier upstreams for background work
# targets = ["orcarouter/z-ai/glm-5.3-flash-free", "orcarouter/deepseek/deepseek-v4-flash-free", "gemini/gemini-3-flash"]
# [[combo]]
# name = "planning"               # frontier models for plan/default/advisor roles
# targets = ["anthropic/claude-sonnet-4-5", "gemini/gemini-3-pro", "openrouter/deepseek/deepseek-v3.2"]

# Step 2 (issue #54, task_routing = "on"): per-model capability scores the
# classifier scores combo targets against. power 0–150 (higher = more
# capable); vision/reasoning gate hard-miss penalties (a non-vision model
# on an image request sorts last, a non-reasoning model on a heavy task is
# -120); context/max_out are token limits for the >85%-context guard
# (0 = unknown, no penalty). Declared models always outrank undeclared
# ones of equal distance. Exact model id or path.Match glob.
# [[providers.tier]]
# model = "claude-sonnet-4-5"
# power = 110
# vision = true
# reasoning = true
# context = 200000
# max_out = 64000

# --- OAuth device-flow accounts (issue #2) ----------------------------------
# Subscription providers (xAI/Grok, Kilo Code) log in with a device flow:
# `onegw-oauth login -provider xai -account main`. The token is stored in
# <data_dir>/oauth-tokens.json (0600), injected as the upstream bearer
# credential at request time, and auto-refreshed before expiry. The account
# must match a [[providers]] entry; the static api_key is the fallback
# while no token is stored (e.g. before the first login).
#
# [[oauth.accounts]]
# provider = "xai"        # [[providers]] name
# account  = "main"       # [[providers.accounts]] name
# service  = "xai"        # oauth profile: xai | kilocode (default: provider)
# # Endpoint overrides for self-hosted IdPs / staging:
# # device_url / token_url / client_id / scope

# [update] keeps the binary current against GitHub releases.
#
# check_interval: how often the gateway checks for a newer release (Go
#   duration). "0" or "off" disables background checks — the `onegw update`
#   command always checks on demand.
# auto: apply a newer release automatically via zero-drop handoff restart.
#   Off by default. Ignored inside containers (update the image instead).
# repo: GitHub owner/name to poll for releases.
#
# [update]
# check_interval = "24h"
# auto = false
# repo = "FreePeak/onegw"
